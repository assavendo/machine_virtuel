{
  "specVersion": "1.0",
  "status": "draft-needs-human-review",
  "note": "Maps every file of THIRD_PARTY/SBOM.json to the component(s) it comes from. 'declared' confidence means the component and license come from DroidVM-license.yaml. 'inferred' confidence means the path-to-component link or the license was deduced from the upstream project and has NOT been verified against the real build; a human must confirm it before a release is declared supply-chain complete.",
  "additionalComponents": [
    {"name": "android-hardware-graphics-common", "license": "Apache-2.0", "basis": "AOSP hardware interface library", "verified": false, "urls": ["https://android.googlesource.com/platform/hardware/interfaces/"]},
    {"name": "libepoxy", "license": "MIT", "basis": "upstream project license", "verified": false, "urls": ["https://github.com/anholt/libepoxy"]},
    {"name": "libffi", "license": "MIT", "basis": "upstream project license", "verified": false, "urls": ["https://github.com/libffi/libffi"]},
    {"name": "glib", "license": "LGPL-2.1-or-later", "basis": "upstream project license", "verified": false, "urls": ["https://gitlab.gnome.org/GNOME/glib"]},
    {"name": "gettext-runtime", "license": "LGPL-2.1-or-later", "basis": "upstream license of libintl; confirm which libintl implementation was built", "verified": false, "urls": ["https://www.gnu.org/software/gettext/"]},
    {"name": "pcre2", "license": "BSD-3-Clause", "basis": "upstream project license (with the PCRE2 binary-distribution exemption)", "verified": false, "urls": ["https://github.com/PCRE2Project/pcre2"]},
    {"name": "pixman", "license": "MIT", "basis": "upstream project license", "verified": false, "urls": ["https://gitlab.freedesktop.org/pixman/pixman"]},
    {"name": "rutabaga_gfx", "license": "BSD-3-Clause", "basis": "crate developed in the crosvm repository", "verified": false, "urls": ["https://github.com/google/crosvm"]},
    {"name": "libslirp", "license": "BSD-3-Clause", "basis": "upstream project license", "verified": false, "urls": ["https://gitlab.freedesktop.org/slirp/libslirp"]},
    {"name": "libusb", "license": "LGPL-2.1-or-later", "basis": "upstream project license", "verified": false, "urls": ["https://github.com/libusb/libusb"]},
    {"name": "virglrenderer", "license": "MIT", "basis": "upstream project license", "verified": false, "urls": ["https://gitlab.freedesktop.org/virgl/virglrenderer"]},
    {"name": "mesa-freedreno-vulkan", "license": "MIT", "basis": "Mesa project license for the Turnip/freedreno Vulkan driver", "verified": false, "urls": ["https://gitlab.freedesktop.org/mesa/mesa"]}
  ],
  "rules": [
    {"pattern": "bin/bridgedhcp", "components": ["bridgedhcp"], "confidence": "declared"},
    {"pattern": "bin/gvswitch", "components": ["gvisor-vswitch"], "confidence": "declared"},
    {"pattern": "bin/lbx", "components": ["linux-boot-extractor"], "confidence": "declared"},
    {"pattern": "bin/netbox", "components": ["netbox"], "confidence": "declared"},
    {"pattern": "bin/pbridge", "components": ["pseudo-bridge-rs"], "confidence": "declared"},
    {"pattern": "usr/bin/busybox", "components": ["busybox"], "confidence": "declared"},
    {"pattern": "usr/bin/crosvm", "components": ["crosvm"], "confidence": "declared"},
    {"pattern": "usr/bin/magisk*", "components": ["magisk"], "confidence": "declared"},
    {"pattern": "usr/bin/pv", "components": ["pv"], "confidence": "declared"},
    {"pattern": "usr/bin/qemu-*", "components": ["qemu"], "confidence": "declared"},
    {"pattern": "usr/lib/android.hardware.graphics.common-*", "components": ["android-hardware-graphics-common"], "confidence": "inferred"},
    {"pattern": "usr/lib/libepoxy.so", "components": ["libepoxy"], "confidence": "inferred"},
    {"pattern": "usr/lib/libffi.so", "components": ["libffi"], "confidence": "inferred"},
    {"pattern": "usr/lib/libgfxstream_backend.so", "components": ["gfxstream"], "confidence": "declared"},
    {"pattern": "usr/lib/libg[iolm]*-2.0.so", "components": ["glib"], "confidence": "inferred"},
    {"pattern": "usr/lib/libintl.so", "components": ["gettext-runtime"], "confidence": "inferred"},
    {"pattern": "usr/lib/libpcre2-8.so", "components": ["pcre2"], "confidence": "inferred"},
    {"pattern": "usr/lib/libpixman-1.so", "components": ["pixman"], "confidence": "inferred"},
    {"pattern": "usr/lib/librutabaga_gfx_ffi.so", "components": ["rutabaga_gfx"], "confidence": "inferred"},
    {"pattern": "usr/lib/libslirp.so", "components": ["libslirp"], "confidence": "inferred"},
    {"pattern": "usr/lib/libusb-1.0.so", "components": ["libusb"], "confidence": "inferred"},
    {"pattern": "usr/lib/libvirglrenderer.so", "components": ["virglrenderer"], "confidence": "inferred"},
    {"pattern": "usr/lib/libvncserver.so", "components": ["libvncserver"], "confidence": "declared"},
    {"pattern": "usr/lib/libvulkan_freedreno.so", "components": ["mesa-freedreno-vulkan"], "confidence": "inferred"},
    {"pattern": "usr/lib/modules/android*/*.ko", "components": ["linux"], "confidence": "inferred"},
    {"pattern": "usr/lib/modules/descr/*.html", "components": ["linux"], "confidence": "inferred"},
    {"pattern": "usr/lib/modules/match.json", "components": ["droidvm"], "confidence": "inferred"},
    {"pattern": "usr/share/droidvm/agent/run.sh", "components": ["droidvm"], "confidence": "declared"},
    {"pattern": "usr/share/droidvm/edk2-*.fd", "components": ["edk2"], "confidence": "declared"},
    {"pattern": "usr/share/droidvm/initramfs.img", "components": ["linux", "busybox"], "confidence": "inferred", "note": "Archive contents are not enumerated; extract it and list its real members before release."},
    {"pattern": "usr/share/droidvm/vmlinuz", "components": ["linux"], "confidence": "declared"},
    {"pattern": "usr/share/qemu/efi-virtio.rom", "components": ["qemu"], "confidence": "inferred", "note": "ROM built from iPXE sources in the QEMU tree; confirm its license terms."},
    {"pattern": "usr/share/qemu/keymaps/*", "components": ["qemu"], "confidence": "declared"}
  ]
}
